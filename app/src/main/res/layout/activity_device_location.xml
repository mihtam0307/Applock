<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:gravity="center"
        android:text="@string/location_fetching" />

    <Button
        android:id="@+id/btnRefreshLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_panel"
        android:textColor="@color/accent"
        android:text="@string/btn_refresh_location" />

    <Button
        android:id="@+id/btnOpenInMaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_panel"
        android:textColor="@color/accent"
        android:enabled="false"
        android:text="@string/btn_open_in_maps" />

</LinearLayout>
