<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvSetupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thiết lập mã số chủ"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSetupSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mã số này dùng để mở các ứng dụng đã khoá (đúng 6 số)"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etMasterPin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_glass_panel"
        android:padding="14dp"
        android:gravity="center"
        android:hint="@string/enter_pin"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="6" />

    <EditText
        android:id="@+id/etMasterPinConfirm"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_panel"
        android:padding="14dp"
        android:gravity="center"
        android:hint="@string/confirm_pin"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="6" />

    <TextView
        android:id="@+id/tvSetupError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/danger"
        android:visibility="invisible"
        android:text="@string/wrong_password" />

    <Button
        android:id="@+id/btnSetupSave"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_glass_panel"
        android:textColor="@color/text_primary"
        android:text="@string/btn_save" />

</LinearLayout>
